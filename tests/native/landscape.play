# Landscape phone (DPR 3): the Daily challenge from the title, solved with the narrow rail's Hint button, to its results.
# Generated by tools/gen-plays.mjs.
# viewport 844x390@3
until 300 =Play
frames 150
save land-title
touch Daily challenge
until 60 Expected duration
frames 10
save land-setup
touch =Start
until 120 Tray pieces
frames 60
save land-play
repeat 3000 until Mosaic complete!
  touch =Hint
  frames 12
end
frames 30
save land-results
